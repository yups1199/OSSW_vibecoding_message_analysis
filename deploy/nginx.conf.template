worker_processes 1;
pid /var/run/nginx.pid;
# No forced worker shutdown: preserve in-flight requests while workers drain.
error_log /dev/stderr warn;
events { worker_connections 1024; }
http {
    access_log off;
    client_max_body_size 5m;
    client_body_buffer_size 5m;
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_connect_timeout 3s;
    proxy_read_timeout 60s;
    # Deployed metadata is used together with live /health, never alone.
    # kakao-slot=@@SLOT@@
    # kakao-version=@@VERSION@@
    # kakao-run=@@RUN@@
    upstream kakao_backend { server @@UPSTREAM@@:8000; }
    server {
        listen 80;
        server_name _;
        location / {
            proxy_pass http://kakao_backend;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }
}
